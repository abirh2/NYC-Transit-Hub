{
  "name": "nyc-transit-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "native:dev": "vite --config vite.native.config.ts",
    "native:dev:lan": "vite --config vite.native.config.ts --host 0.0.0.0",
    "native:build": "vite build --config vite.native.config.ts",
    "native:verify": "node scripts/verify-native-bundle.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "data:subway-geometry": "node scripts/build-subway-geometry.mjs",
    "cap:sync": "cap sync ios",
    "cap:ios": "cap open ios",
    "ios:dev": "CAPACITOR_USE_REMOTE_SERVER=true cap sync ios && cap open ios",
    "ios:build": "npm run native:build && npm run native:verify && env -u CAPACITOR_USE_REMOTE_SERVER -u CAPACITOR_SERVER_URL cap sync ios",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@heroui/react": "^2.8.5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@serwist/next": "^9.2.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@types/leaflet": "^1.9.21",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "mta-subway-bullets": "^1.0.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "prisma": "^7.10.0",
    "protobufjs": "^7.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.5.1",
    "serwist": "^9.2.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.0",
    "@storybook/addon-docs": "^10.1.0",
    "@storybook/addon-onboarding": "^10.1.0",
    "@storybook/addon-vitest": "^10.1.0",
    "@storybook/nextjs-vite": "^10.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "eslint-plugin-storybook": "^10.1.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "sharp": "^0.35.4",
    "storybook": "^10.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
